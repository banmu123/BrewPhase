{
  "name": "brewphase-chrome-companion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "BrewPhase Chrome Companion — save the current page to BrewPhase Records",
  "scripts": {
    "build": "vite build && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "host:build": "node scripts/build-host.mjs",
    "extension-id": "node scripts/extension-id.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "happy-dom": "^21.0.4",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
