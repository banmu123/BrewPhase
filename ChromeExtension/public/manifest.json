{
  "manifest_version": 3,
  "name": "BrewPhase Chrome Companion",
  "description": "Save the page you are reading to BrewPhase Records — only when you click.",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "action": {
    "default_title": "Save to BrewPhase",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "nativeMessaging",
    "contextMenus"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": ""
}
