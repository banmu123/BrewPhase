{
  "name": "@brewphase/cloud",
  "version": "0.1.0",
  "private": true,
  "description": "BrewPhase Cloud — independent cloud account service (Google/GitHub OAuth, unified BrewPhase identity, session management)",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:migrate:prod": "node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.10.3",
    "jose": "^6.1.0",
    "postgres": "^3.4.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^5.1.0"
  }
}
