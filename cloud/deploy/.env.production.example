# BrewPhase Remote MCP — 生产环境变量模板
#
# 用法：
#   cp .env.production.example .env.production
#   chmod 600 .env.production
#   $EDITOR .env.production        # 填入真实值（下面每项都有生成命令）
#
# ⚠️ **所有 compose 命令都必须显式带上本文件**：
#      docker compose --env-file .env.production <子命令>
#    Compose 只会自动读项目目录里名为 `.env` 的文件，不会读 `.env.production`。
#    漏掉 `--env-file` 时插值会因缺变量直接失败（这是刻意的 fail-closed），
#    完整命令清单见 deploy/README.md。
#
# ⚠️ `.env.production` 含数据库口令、JWT 密钥、OAuth Client Secret。
#    **严禁提交到 Git**（已在 .gitignore 与 .dockerignore 中排除，别改回来）。
#    部署机上建议放在 deploy/ 目录外或用 secrets 管理。
#
# 本文件只列变量名与生成方式，**没有任何真实值**。

# ── 基础 ─────────────────────────────────────────────────────────────────────
# 必须是 production，否则 enforceProductionSecrets 不会执行（预检也会拒绝）
NODE_ENV=production

# 对外地址（同时是 JWT iss、Provider 回调前缀、Discovery issuer、WSS Host 白名单来源）。
# 必须是**公网 HTTPS 纯 Origin**：无 path / query / fragment，非回环主机，
# 且**只用默认 443 端口**（compose 只发布 80/443，写 :8443 预检会拒绝）。
BASE_URL=https://api.phase.commitbrew.com

# 反代后的监听端口（与 compose 里 cloud 的 expose 一致；不发布到宿主）
PORT=3000

# ── 数据库（compose 内用服务名 db，不是 127.0.0.1）─────────────────────────
# compose.yaml 用**字符串拼接**把下面三个变量拼成 DATABASE_URL：
#   postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
# 没有 URL 编码，所以口令必须是 URL 安全的。
#
#   生成： openssl rand -hex 32
#   允许字符：A-Z a-z 0-9 . _ ~ -   （其余一律被预检拒绝）
#
# ⚠️ 不要用 `openssl rand -base64 24`：它会产出 `/`，拼出来的 DATABASE_URL
#    连 `new URL()` 都解析不了；含 `@` 时更隐蔽——解析器会把口令改写成 %40，
#    看起来能连、拿到的口令却不是这个值。
#    预检会拒绝保留字符、过短值与占位值（含下面这个示例占位）。
POSTGRES_USER=brewphase
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=brewphase_cloud

# ── 密钥（生产必填；生成后**不要**写回本文件以外的任何地方）──────────────
#   openssl rand -base64 48
JWT_SIGNING_KEY=
# 轮换预留（可选）：验证已签发的旧 Token，使轮换平滑过渡
JWT_SIGNING_KEY_PREVIOUS=
#   openssl rand -base64 32
SESSION_TOKEN_PEPPER=

# ── Provider（两套回调都要登记，共 4 条；见 cloud/README.md「必须登记四个回调」）─
#   {BASE_URL}/oauth/callback/google          ← Desktop 登录
#   {BASE_URL}/mcp/oauth/callback/google      ← Remote MCP 授权
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#   {BASE_URL}/oauth/callback/github          ← Desktop 登录
#   {BASE_URL}/mcp/oauth/callback/github      ← Remote MCP 授权
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Remote MCP 专用（缺它则 /mcp、/.well-known/*、/mcp/oauth/* 全部 404）──
#   openssl rand -base64 48
# 必须 ≥32 UTF-8 字节，且**不得等于 JWT_SIGNING_KEY**
MCP_BROWSER_SESSION_KEY=

# ── 单副本硬约束（WSS 路由表在进程内存里，Phase 1.4 前不可多副本）──────────
GATEWAY_EXPECTED_REPLICAS=1

# ── 代理信任边界 ────────────────────────────────────────────────────────────
# 真实链路只有 Caddy 一层，且 cloud:3000 未发布端口（无法绕过 Caddy 直连），
# 所以右端 1 条由 Caddy 追加的 XFF 是可信的。
TRUST_PROXY=true
TRUST_PROXY_HOPS=1

# ── WSS Host 白名单（留空 = 从 BASE_URL 推导，正常部署不需要填）────────────
# 只有「反代改写了 Host」时才需要显式配置——而 Caddy 默认不改写，所以留空。
GATEWAY_ALLOWED_HOSTS=

# ── HTTP CORS（注意：这**不是** WSS 的 Origin 白名单）──────────────────────
# WSS 白名单 = BASE_URL Origin ∪ CORS_ORIGINS，由 resolveWebSocketAllowedOrigins
# 构造；本变量只控制普通 HTTP 的 Access-Control-Allow-Origin。
# 留空 = 关闭 HTTP CORS（默认，也是推荐值）。
CORS_ORIGINS=

# ── 可选 ────────────────────────────────────────────────────────────────────
# LOG_LEVEL=info
# RATE_LIMIT_MAX_MCP=120
# 仅当 Cloud 直连 Google/GitHub 受阻时才填（Provider 出网代理，不改入站地址）
# HTTPS_PROXY=
# NO_PROXY=localhost,127.0.0.1

# ── Caddy（**必须填，留空会让 compose 直接失败**）─────────────────────────
# 证书到期通知邮箱（ACME 账户联系方式）。
# 留空 = `${ACME_EMAIL:?…}` 报错退出；Caddyfile 里也没有默认值兜底，
# 所以「拿 admin@example.com 去签生产证书」这条路走不通。
ACME_EMAIL=
# 公网域名，供 deploy/Caddyfile 的站点块使用（**必须与 BASE_URL 的 host 逐字一致**）。
# 只能填裸主机名：不要带 https://、路径、query、fragment、userinfo 或端口。
# 留空同上：compose 先给出人话报错，Caddyfile 再兜一层 validate 失败。
BREWPHASE_DOMAIN=
