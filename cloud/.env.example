# BrewPhase Cloud 环境变量示例
# 复制为 .env 并填入真实值；.env 已被 Git 忽略，严禁提交真实 Secret。
# `pnpm dev` 与 `pnpm db:migrate` 会自动加载本目录的 .env（只在 NODE_ENV 不是
# production 时生效，且不覆盖已注入的同名进程环境变量）。
# Secret 生成方式：
#   JWT_SIGNING_KEY / SESSION_TOKEN_PEPPER:
#     openssl rand -base64 48
#   或 Node: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

NODE_ENV=development
PORT=3000

# 服务对外地址（同时作为 JWT iss）。生产必须是 https。
# 本地必须与 Provider 控制台里登记的 Authorized redirect URI **逐字符一致**：
# Google / GitHub 把 http://127.0.0.1:3000 与 http://localhost:3000 当作不同的
# redirect_uri，混用会在 Provider 侧直接报 redirect_uri_mismatch。
# 端口必须与上面的 PORT 一致。
BASE_URL=http://127.0.0.1:3000

DATABASE_URL=postgres://user:password@127.0.0.1:5432/brewphase_cloud

# Google OAuth Client（Web application 类型，Authorized redirect URI 填
# {BASE_URL}/oauth/callback/google，本地即
# http://127.0.0.1:3000/oauth/callback/google）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App（**不是** GitHub App，也不是 PAT；Authorization callback URL 填
# {BASE_URL}/oauth/callback/github，本地即
# http://127.0.0.1:3000/oauth/callback/github）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT 签名密钥（至少 32 字符；生产环境必填，不允许弱默认值）
JWT_SIGNING_KEY=

# 轮换预留：旧签名密钥（可选，仅用于验证已签发的旧 Token，使轮换平滑过渡）
JWT_SIGNING_KEY_PREVIOUS=

# IP 哈希盐 + 哈希域分隔（至少 16 字符；生产环境必填）
SESSION_TOKEN_PEPPER=

# ---- MCP 浏览器授权（Phase 1.3.1-C1 起的基础设施）----
# 浏览器授权 Cookie（bp_mcp_bs）的 HMAC 签名密钥，至少 32 字节。
# **必须与 JWT_SIGNING_KEY 不同**：共用一个密钥会让 Cookie 签名与 token 签名
# 互为伪装面。
#   生成： openssl rand -base64 48
#
# 留空的含义：MCP 浏览器授权能力未配置。C2 挂载 /mcp/oauth/* 路由时会因为
# 缺这个值而**不注册那些路由**（fail-closed 在能力边界上）。留空不影响现有的
# Desktop 登录（/oauth/* 与 /auth/*），所以本地只跑登录时可以不填。
MCP_BROWSER_SESSION_KEY=

# ---- 可选：以下均有合理默认值 ----
# Access Token 有效期（秒，允许 600–900，默认 900）
# ACCESS_TOKEN_TTL_SECONDS=900
# Refresh 会话绝对有效期（秒，默认 30 天）
# REFRESH_SESSION_TTL_SECONDS=2592000
# OAuth Transaction 有效期（秒，默认 300）
# OAUTH_TRANSACTION_TTL_SECONDS=300
# 一次性授权码有效期（秒，默认 60）
# OAUTH_CODE_TTL_SECONDS=60

# 限流（每 IP 固定窗口）
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_AUTHORIZE=30
# RATE_LIMIT_MAX_TOKEN=20
# RATE_LIMIT_MAX_AUTH=30
# RATE_LIMIT_MAX_MCP=120

# CORS 允许来源（逗号分隔；留空 = 完全关闭 CORS）
# CORS_ORIGINS=

# 是否信任反向代理的 X-Forwarded-For（生产部署在代理后必须显式开启）
# TRUST_PROXY=false
# 可信代理层数：从 XFF 右端跳过 N 个条目取客户端 IP（1 = 单层反代，允许 1–5）
# 必须准确匹配真实代理链路的层数，不要靠加大取值来提高安全性——两个方向都会算错身份：
#   过小：取到上游代理 IP 而非客户端 IP（不回退 socket）→ 同代理后的用户共享一个桶（429）
#   过大：条目不足时回退 socket（同样共享一个桶）；客户端自带伪造条目时选中其伪造值 →
#         每个伪造值一个新桶，限流被完全绕过（fail-open）
# 追加式代理：等于真实层数；覆盖式代理：只能是 1（多层覆盖式请改用追加式，否则
# 所有用户会回退到同一个 socket 地址、共享同一限流桶）
# 安全前提：开启 TRUST_PROXY 时服务端口不可被客户端绕过代理直接访问
# TRUST_PROXY_HOPS=1

# 日志级别 debug|info|warn|error
# LOG_LEVEL=info

# ---- 可选：Provider 出网代理 ----
# Cloud 直连 Google / GitHub 的 token 端点与 JWKS。若本机无法直连（典型表现：
# 授权页能打开，但回调后立刻失败，日志里是 Google/GitHub token endpoint is
# unreachable），可以填本机 HTTP(S) 代理。只影响 Provider 出网，不影响
# 入站监听，也不改变对 Desktop 暴露的地址。
# 支持 http:// 与 https:// 代理（不支持 SOCKS）；NO_PROXY 命中的主机会直连。
# HTTPS_PROXY=http://127.0.0.1:7900
# NO_PROXY=localhost,127.0.0.1

# ---- 可选：Provider 端点覆盖（仅测试 / 私有化部署使用，默认为官方地址）----
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# GOOGLE_ISSUER=https://accounts.google.com
# GITHUB_AUTH_URL=https://github.com/login/oauth/authorize
# GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_API_BASE=https://api.github.com
