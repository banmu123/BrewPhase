# BrewPhase Cloud 环境变量示例
# 复制为 .env 并填入真实值；.env 已被 Git 忽略，严禁提交真实 Secret。
# Secret 生成方式：
#   JWT_SIGNING_KEY / SESSION_TOKEN_PEPPER:
#     openssl rand -base64 48
#   或 Node: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"

NODE_ENV=development
PORT=3000

# 服务对外地址（同时作为 JWT iss）。生产必须是 https。
BASE_URL=http://localhost:3000

DATABASE_URL=postgres://user:password@127.0.0.1:5432/brewphase_cloud

# Google OAuth Client（Web application 类型，Authorized redirect URI 填
# {BASE_URL}/oauth/callback/google）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App（Authorization callback URL 填 {BASE_URL}/oauth/callback/github）
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# JWT 签名密钥（至少 32 字符；生产环境必填，不允许弱默认值）
JWT_SIGNING_KEY=

# 轮换预留：旧签名密钥（可选，仅用于验证已签发的旧 Token，使轮换平滑过渡）
JWT_SIGNING_KEY_PREVIOUS=

# IP 哈希盐 + 哈希域分隔（至少 16 字符；生产环境必填）
SESSION_TOKEN_PEPPER=

# ---- 可选：以下均有合理默认值 ----
# Access Token 有效期（秒，允许 600–900，默认 900）
# ACCESS_TOKEN_TTL_SECONDS=900
# Refresh 会话绝对有效期（秒，默认 30 天）
# REFRESH_SESSION_TTL_SECONDS=2592000
# OAuth Transaction 有效期（秒，默认 300）
# OAUTH_TRANSACTION_TTL_SECONDS=300
# 一次性授权码有效期（秒，默认 60）
# OAUTH_CODE_TTL_SECONDS=60

# 限流（每 IP 固定窗口）
# RATE_LIMIT_WINDOW_MS=60000
# RATE_LIMIT_MAX_AUTHORIZE=30
# RATE_LIMIT_MAX_TOKEN=20
# RATE_LIMIT_MAX_AUTH=30

# CORS 允许来源（逗号分隔；留空 = 完全关闭 CORS）
# CORS_ORIGINS=

# 是否信任反向代理的 X-Forwarded-For（生产部署在代理后必须显式开启）
# TRUST_PROXY=false
# 可信代理层数：从 XFF 右端跳过 N 个条目取客户端 IP（1 = 单层反代，允许 1–5）
# 安全前提：开启 TRUST_PROXY 时服务端口不可被客户端绕过代理直接访问
# TRUST_PROXY_HOPS=1

# 日志级别 debug|info|warn|error
# LOG_LEVEL=info

# ---- 可选：Provider 端点覆盖（仅测试 / 私有化部署使用，默认为官方地址）----
# GOOGLE_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
# GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
# GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# GOOGLE_ISSUER=https://accounts.google.com
# GITHUB_AUTH_URL=https://github.com/login/oauth/authorize
# GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
# GITHUB_API_BASE=https://api.github.com
